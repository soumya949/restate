# Copy to `.env` (git-ignored) and fill in. Never commit real values.
# Used by the live smoke tests and the examples. Unit / Restate integration tests need none of these.

# ── OpenBox sandbox agent (P0 live smoke, P1) ─────────────────────────────
# Base URL of OpenBox Core. OPENBOX_URL is accepted as an alias.
OPENBOX_API_URL=https://core.openbox.ai
# Agent API key from "Save Your Agent Credentials" (use an obx_test_* key for dev)
OPENBOX_API_KEY=obx_test_xxxxxxxxxxxxxxxx
# Agent DID and Ed25519 private key (base64 32-byte seed). Set both, or neither if
# "Require signed requests" is off for the agent.
OPENBOX_AGENT_DID=did:aip:00000000-0000-0000-0000-000000000000
OPENBOX_AGENT_PRIVATE_KEY=
# Optional: default fail_open (matches every OpenBox SDK)
# OPENBOX_ON_API_ERROR=fail_open

# ── Restate-specific (all optional; defaults shown) ───────────────────────
# OPENBOX_RESTATE_AGENT_NAME=
# OPENBOX_RESTATE_APPROVAL_POLL_INTERVAL_MS=15000
# OPENBOX_RESTATE_APPROVAL_WAIT_CAP_MS=3600000
# OPENBOX_RESTATE_APPROVAL_OUTAGE_POLICY=fail_closed
# OPENBOX_RESTATE_GOVERNANCE_MAX_RETRIES=3
# OPENBOX_RESTATE_HITL_ENABLED=true

# ── LLM (P1 real examples) ────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Live approval test (needs a human to click Approve in the dashboard) ──
# OPENBOX_LIVE_APPROVAL=1

# ── Restate: nothing needed for local runs (restate-server / Docker). ─────
# ── Restate Cloud (optional; see README "Restate Cloud") ──────────────────
# All on the environment's "Integration & API keys" page. The API key is secret (Full scope).
# RESTATE_CLOUD_ENV_ID=env_xxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESTATE_CLOUD_INGRESS_URL=https://<env id without env_>.env.<region>.restate.cloud:8080
# RESTATE_CLOUD_ADMIN_URL=https://<env id without env_>.env.<region>.restate.cloud:9070
# RESTATE_CLOUD_TUNNEL_SERVERS_SRV=tunnel.<region>.restate.cloud
# RESTATE_CLOUD_IDENTITY_KEY=publickeyv1_xxxxxxxx
# RESTATE_CLOUD_API_KEY=key_xxxxxxxx
# Read by every example: accept only requests signed by your Cloud environment
# (set it to RESTATE_CLOUD_IDENTITY_KEY; leave unset for a local Restate server).
# RESTATE_IDENTITY_KEYS=publickeyv1_xxxxxxxx

# ── Child agent for the multi-agent example (P2): a SECOND sandbox agent ─────
# Its own API key / DID / key: never reuse the parent's identity.
# CHILD_OPENBOX_API_KEY=obx_test_xxxxxxxxxxxxxxxx
# CHILD_OPENBOX_AGENT_DID=
# CHILD_OPENBOX_AGENT_PRIVATE_KEY=
